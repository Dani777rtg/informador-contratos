# Copia a .env (ignorado por git). Nunca subas valores reales.
PORT=8080
NODE_ENV=
# 1 = sustitutos locales de Socrata/DeepSeek/Deepgram/WhatsApp (prohibido con NODE_ENV=production)
MOCK_EXTERNALS=
ALLOWED_ORIGINS=
HMAC_SECRET=
SESSION_SECRET=
METRICS_TOKEN=
DATOSGOV_APP_TOKEN=
SOCRATA_BASE=https://www.datos.gov.co
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DAILY_TOKEN_CAP=1000000
RATE_LIMIT_PER_MIN=20
MAX_TURNS=30
MAX_AUDIO_MS=60000
MAX_TOOLS_PER_TURN=3
WS_TOKEN_TTL_MS=300000
DEEPGRAM_API_KEY=
DEEPGRAM_STT_URL=wss://api.deepgram.com/v2/listen
DEEPGRAM_TTS_URL=wss://api.deepgram.com/v1/speak
TTS_VOICE=aura-2-celeste-es
VOICE_SESSION_MAX_SECONDS=1800
VOICE_DAILY_MAX_MINUTES=120
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WABA_ID=
WHATSAPP_TEMPLATE=resumen_secop
WHATSAPP_API_VERSION=v21.0
GOOGLE_CLOUD_PROJECT=
# Solo pruebas de carga locales (ms de latencia simulada)
MOCK_LATENCY_MS_SOCRATA=
MOCK_LATENCY_MS_DEEPSEEK=
MOCK_LATENCY_MS_DEEPGRAM=
MOCK_LATENCY_MS_WHATSAPP=
# Modelo solo para la voz (opcional; por defecto DEEPSEEK_MODEL). Ver docs/VOZ.md
DEEPSEEK_VOICE_MODEL=
